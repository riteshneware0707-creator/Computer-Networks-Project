{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self-Healing Adaptive Network experiment result",
  "type": "object",
  "required": ["scenario"],
  "properties": {
    "scenario": { "type": "string", "minLength": 1 },
    "simulationTimeSec": { "type": "number", "minimum": 0 },
    "totalTxPackets": { "type": "integer", "minimum": 0 },
    "totalRxPackets": { "type": "integer", "minimum": 0 },
    "totalLostPackets": { "type": "integer", "minimum": 0 },
    "packetLossPct": { "type": "number", "minimum": 0, "maximum": 100 },
    "averageDelayMs": { "type": "number", "minimum": 0 },
    "throughputMbps": { "type": "number", "minimum": 0 },
    "linkUtilizationPct": { "type": "number", "minimum": 0, "maximum": 100 },
    "r1R2Packets": { "type": "integer", "minimum": 0 },
    "r2R4Packets": { "type": "integer", "minimum": 0 },
    "r1R3Packets": { "type": "integer", "minimum": 0 },
    "r3R4Packets": { "type": "integer", "minimum": 0 },
    "routeSwitchTimeSec": { "type": ["number", "null"], "minimum": 0 },
    "firstAlternateTrafficTimeSec": { "type": ["number", "null"], "minimum": 0 },
    "alternateTrafficDetected": { "type": "boolean" },
    "routeApplicationAttempted": { "type": "boolean" },
    "selectedRoute": { "type": "string" },
    "primaryPathAvailable": { "type": "boolean" },
    "alternatePathAvailable": { "type": "boolean" },
    "failureTimeSec": { "type": ["number", "null"], "minimum": 0 },
    "recoveryTimeSec": { "type": ["number", "null"], "minimum": 0 },
    "failureToAlternateTrafficMs": { "type": ["number", "null"], "minimum": 0 },
    "restoreToPrimaryTrafficMs": { "type": ["number", "null"], "minimum": 0 },
    "routeSwitchEvents": { "type": "integer", "minimum": 0 },
    "randomSeed": { "type": "integer", "minimum": 0 },
    "randomRun": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
